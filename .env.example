# Uvicorn Server Configuration
UVICORN_HOST=127.0.0.1
UVICORN_PORT=9000
UVICORN_ROOT_PATH=
UVICORN_RELOAD=true

# JWT Configuration
UVICORN_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
UVICORN_JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
UVICORN_JWT_SECRET_KEY=replace-with-a-secure-secret-of-at-least-32-characters
UVICORN_JWT_REFRESH_SECRET_KEY=replace-with-a-different-secure-secret-of-at-least-32-characters

# Database Configuration
UVICORN_DATABASE_SCHEMA=public
UVICORN_DATABASE_URL=sqlite:///db.sqlite3
UVICORN_DATABASE_SCHEMA=python_crud

# Rate Limiting Configuration (SlowAPI)
UVICORN_RATE_LIMIT_STORAGE_URI=memory://
UVICORN_RATE_LIMIT_LOGIN=10/minute
UVICORN_RATE_LIMIT_REFRESH=10/minute
UVICORN_RATE_LIMIT_BOOTSTRAP=3/minute

# CORS Configuration
UVICORN_CORS_ALLOW_ORIGINS=["http://localhost:9000","https://frontend.example.com"]
UVICORN_CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
UVICORN_CORS_ALLOW_HEADERS=["Authorization","Content-Type"]
UVICORN_CORS_ALLOW_CREDENTIALS=false

# Password Reset
UVICORN_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
UVICORN_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# SMTP Configuration
UVICORN_SMTP_HOST=
UVICORN_SMTP_PORT=587
UVICORN_SMTP_USERNAME=
UVICORN_SMTP_PASSWORD=
UVICORN_SMTP_FROM=
# SMTP transport: authentication requires SSL or STARTTLS.
# Do not disable both when SMTP credentials are configured.
UVICORN_SMTP_USE_SSL=false
UVICORN_SMTP_STARTTLS=true

# Rate Limiting
UVICORN_RATE_LIMIT_PASSWORD_RESET=3/minute