# Uvicorn Server Configuration
UVICORN_HOST=127.0.0.1
UVICORN_PORT=9001
UVICORN_ROOT_PATH=
UVICORN_RELOAD=true

# JWT Configuration
UVICORN_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
UVICORN_JWT_SECRET_KEY=12345678901234567890123456789012

# Database Configuration
DATABASE_SCHEMA=public
DATABASE_URL=sqlite:///db.sqlite3
