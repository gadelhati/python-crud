# Uvicorn Server Configuration
UVICORN_HOST=127.0.0.1
UVICORN_PORT=9001
UVICORN_ROOT_PATH=
UVICORN_RELOAD=true

# JWT Configuration
UVICORN_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
UVICORN_JWT_SECRET_KEY=replace-with-a-secure-secret-of-at-least-32-characters

# Database Configuration
UVICORN_DATABASE_SCHEMA=public
UVICORN_DATABASE_URL=sqlite:///db.sqlite3